# Copy this file to .env.local and fill in the keys you have.
# Both are optional — the app automatically falls back to a built-in
# offline "demo mode" (templated stories + placeholder illustrations)
# for any provider whose key is missing, so you can develop and test
# without any credentials at all.

# Anthropic API key — powers story text generation and (if a photo is
# uploaded) a short visual description of the child used to keep the
# illustrated character consistent across pages.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for text/vision generation.
# ANTHROPIC_TEXT_MODEL=claude-sonnet-5

# OpenAI API key — powers illustration generation (gpt-image-1).
# https://platform.openai.com/
OPENAI_API_KEY=

# Optional: override the OpenAI image model.
# OPENAI_IMAGE_MODEL=gpt-image-1
